# Set this to a long, random secret before exposing Faultline beyond localhost.
FAULTLINE_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional. Defaults to data/faultline.json when running directly with Node.
FAULTLINE_DATA_FILE=data/faultline.json

# Optional public HTTPS URL for the packaged Windows client.
# The consent page exposes this as the Faultline.exe download after a user claims an invitation.
FAULTLINE_WINDOWS_CLIENT_URL=https://downloads.example.com/Faultline.exe

# Optional. Enables Cloudflare Radar outage annotations in the live diagnostic panel.
# Faultline works fully without it and shows "Not configured" when unset.
# Every other Internet-intelligence source (RIPEstat, Globalping, RIPE Atlas, IODA,
# PeeringDB) requires no credential at all.
# FAULTLINE_CLOUDFLARE_RADAR_TOKEN=

# Optional. The Faultline Analyst (local AI) endpoint. Must be loopback:
# a non-loopback value disables the Analyst and leaves the rest of Faultline
# working. Faultline never sends network evidence to a remote inference host.
# FAULTLINE_ANALYST_ENDPOINT=http://127.0.0.1:11434

# Optional. The local Ollama model the Analyst uses. Must be a locally installed,
# non-cloud model; ":cloud" models proxy inference to ollama.com and are refused.
# FAULTLINE_ANALYST_MODEL=qwen3:8b

# Optional. Flight Recorder incidents are written to the Faultline store so an
# investigation survives a restart. Set to 0 to keep them in memory only.
# The rolling sample buffer is never persisted either way.
# FAULTLINE_RECORDER_PERSIST=1
