# Set this to a long, random secret before exposing Faultline beyond localhost.
FAULTLINE_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional. Defaults to data/faultline.json when running directly with Node.
FAULTLINE_DATA_FILE=data/faultline.json

# Optional public HTTPS URL for the packaged Windows client.
# The consent page exposes this as the Faultline.exe download after a user claims an invitation.
FAULTLINE_WINDOWS_CLIENT_URL=https://downloads.example.com/Faultline.exe
