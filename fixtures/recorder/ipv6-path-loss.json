      "ipv6": "PASS",
      "gatewayMs": 2,
      "gatewayLossPct": 0,
      "activeInterface": "Ethernet",
      "gateway": "192.168.1.1",
      "resolvers": [
        "10.20.0.53"
      ],
      "vpn": false,
      "targetDns": "PASS",
      "targetDnsV4": 1,
